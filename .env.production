# ============================================================
# NUSUK — .env.production
# ⚠️ عدّل APP_KEY بعد أول تشغيل أو اتركه فارغ ليُولّد تلقائياً
# ============================================================

APP_NAME=NUSUK
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nusuk.grade.sbs
APP_LOCALE=ar

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=nusuk.grade.sbs
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# سعر صرف SAR → JOD
SAR_TO_JOD=0.1880

# Trusted Proxies (Cloudflare)
TRUSTED_PROXIES=*
